{
  "manifest_version": 3,
  "name": "Brave Control for Codex",
  "version": "0.3.5",
  "description": "Give Codex secure, explicit control of Brave tabs you choose to share.",
  "icons": {
    "16": "icons/chatgpt-final-large-16.png",
    "32": "icons/chatgpt-final-large-32.png",
    "48": "icons/chatgpt-final-large-48.png",
    "128": "icons/chatgpt-final-large-128.png"
  },
  "permissions": ["tabs", "scripting", "storage", "debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Brave Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/chatgpt-final-large-16.png",
      "32": "icons/chatgpt-final-large-32.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
